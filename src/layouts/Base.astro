---
import '../styles/global.css';
import { site } from '../data/site';
import { asset } from '../lib/asset';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.name} | Guided journeys across Greece`, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#005384" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={asset('map/height.webp')} as="image" type="image/webp" crossorigin="anonymous" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: var(--radius-s);
    background: var(--sun-500);
    color: var(--blue-900);
    font-weight: 650;
    text-decoration: none;
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 16px;
  }
</style>
