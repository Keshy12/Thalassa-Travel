---
import { site } from '../data/site';
import { asset } from '../lib/asset';
---

<header class="nav" data-nav>
  <div class="nav__row">
    <a class="nav__logo" href="#top" aria-label="Thalassa Travel, back to top">
      <img src={asset('brand/logo-badge.svg')} alt="Thalassa Travel" width="84" height="84" />
    </a>
    <nav class="nav__links" aria-label="Main">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn--primary nav__cta" href="#contact">Plan your trip</a>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-panel" data-nav-toggle>
      <span class="visually-hidden">Menu</span>
      <span class="nav__burger" aria-hidden="true"></span>
    </button>
  </div>
  <div class="nav__panel" id="nav-panel" data-nav-panel hidden>
    <ul>
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
    <a class="btn btn--primary" href="#contact">Plan your trip</a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 14px var(--gutter) 0;
    pointer-events: none;
    transition: transform 0.5s var(--ease-out);
  }

  .nav.is-hidden {
    transform: translateY(-120%);
  }

  .nav__row {
    display: flex;
    align-items: center;
    gap: 20px;
    max-width: 1400px;
    margin-inline: auto;
  }

  .nav__row > *,
  .nav__panel {
    pointer-events: auto;
  }

  .nav__logo {
    flex: none;
    padding: 7px;
    margin: -7px;
    border-radius: 50%;
  }

  .nav__logo img {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    box-shadow: 0 10px 30px -12px rgb(0 27 46 / 0.55);
    transition: transform 0.5s var(--ease-out);
  }

  .nav__logo:hover img {
    transform: rotate(-6deg) scale(1.03);
  }

  .nav__links {
    margin-inline: auto;
    padding: 6px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--radius-pill);
    background: rgb(0 42 67 / 0.42);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    transition:
      background-color 0.4s,
      border-color 0.4s;
  }

  .nav__links ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__links a {
    display: block;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    color: var(--white);
    font-size: 0.88rem;
    font-weight: 550;
    text-decoration: none;
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .nav__links a:hover {
    background: rgb(255 255 255 / 0.14);
  }

  .nav.is-solid .nav__links {
    border-color: var(--line);
    background: rgb(250 247 242 / 0.82);
  }

  .nav.is-solid .nav__links a {
    color: var(--blue-800);
  }

  .nav.is-solid .nav__links a:hover {
    background: var(--blue-50);
  }

  .nav__cta {
    flex: none;
    min-height: 48px;
  }

  .nav__toggle {
    display: none;
    width: 52px;
    height: 52px;
    margin-left: auto;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 50%;
    background: rgb(0 42 67 / 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    place-items: center;
  }

  .nav.is-solid .nav__toggle {
    background: var(--blue-700);
  }

  .nav__burger,
  .nav__burger::before,
  .nav__burger::after {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--white);
    transition: transform 0.35s var(--ease-out);
  }

  .nav__burger {
    position: relative;
    background: transparent;
  }

  .nav__burger::before,
  .nav__burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav__burger::before {
    top: -4px;
  }

  .nav__burger::after {
    top: 4px;
  }

  .nav__toggle[aria-expanded='true'] .nav__burger::before {
    transform: translateY(4px) rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] .nav__burger::after {
    transform: translateY(-4px) rotate(-45deg);
  }

  .nav__panel {
    margin: 12px auto 0;
    padding: 18px;
    border-radius: var(--radius-m);
    background: var(--paper);
    box-shadow: var(--shadow-2);
  }

  .nav__panel ul {
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
  }

  .nav__panel a:not(.btn) {
    display: block;
    padding: 12px 6px;
    border-bottom: 1px solid var(--line);
    color: var(--blue-900);
    font-family: var(--font-display);
    font-size: 1.35rem;
    text-decoration: none;
  }

  .nav__panel .btn {
    width: 100%;
  }

  @media (max-width: 1020px) {
    .nav__links,
    .nav__cta {
      display: none;
    }

    .nav__toggle {
      display: grid;
    }
  }

  @media (max-width: 600px) {
    .nav {
      padding-top: 10px;
    }

    .nav__logo img {
      width: 76px;
      height: 76px;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (nav && toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };
    toggle.addEventListener('click', () => setOpen(panel.hidden));
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    if (hero) {
      new IntersectionObserver(([entry]) => nav.classList.toggle('is-solid', !entry.isIntersecting), {
        rootMargin: '-90px 0px 0px 0px',
      }).observe(hero);
    }

    let lastY = window.scrollY;
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        const down = y > lastY && y > 240;
        nav.classList.toggle('is-hidden', down && panel.hidden);
        lastY = y;
      },
      { passive: true },
    );
  }
</script>
