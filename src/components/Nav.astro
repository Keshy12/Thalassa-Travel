---
import { destinations } from '../data/destinations';
import { journeys } from '../data/journeys';
import route from '../data/route.json';
import { site } from '../data/site';
import { asset } from '../lib/asset';
import { outline, toOutline } from '../lib/outline';
import Icon from './Icon.astro';

const pad = (n: number) => String(n).padStart(2, '0');
const segments = route.legs.flatMap((leg) =>
  leg.segments.map((s) => ({
    mode: s.mode,
    d: s.points.map(([lon, lat], i) => `${i ? 'L' : 'M'}${toOutline(lon, lat).map((v) => v.toFixed(1)).join(' ')}`).join(''),
  })),
);
---

<header class="site-header" data-nav>
  <a class="site-header__logo" href="#top" aria-label="Thalassa Travel, back to top">
    <img src={asset('brand/logo-badge.svg')} alt="Thalassa Travel" width="84" height="84" />
  </a>
  <div class="site-header__actions">
    <a class="btn btn--primary site-header__cta" href="#contact">Plan your trip</a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-open>
      <Icon name="menu" size={22} />
      <span class="menu-button__label">Menu</span>
    </button>
  </div>
</header>

<div class="menu" id="site-menu" role="dialog" aria-modal="true" aria-label="Menu" data-menu aria-hidden="true" inert>
  <div class="menu__top">
    <a class="menu__logo" href="#top" data-menu-link aria-label="Thalassa Travel, back to top">
      <img src={asset('brand/logo-badge.svg')} alt="Thalassa Travel" width="84" height="84" />
    </a>
    <button class="menu-button menu-button--close" type="button" data-menu-close>
      <Icon name="close" size={22} />
      <span class="menu-button__label">Close</span>
    </button>
  </div>

  <div class="container menu__body">
    <nav aria-label="Main">
      <ol class="menu__links">
        {
          site.nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} data-menu-link>
                <span class="menu__num">{pad(i + 1)}</span>
                <span class="menu__label">{item.label}</span>
                <Icon name="arrow" size={28} class="menu__arrow" />
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <aside class="menu__aside">
      <svg class="menu__map" viewBox={outline.viewBox} role="img" aria-label={`${journeys.find((j) => j.id === 'odyssey')?.name ?? 'Our'} route across Greece`}>
        <path class="menu__land" d={outline.d} vector-effect="non-scaling-stroke"></path>
        {segments.map((s) => <path class:list={['menu__route', `menu__route--${s.mode}`]} d={s.d} vector-effect="non-scaling-stroke" />)}
        {
          destinations.map((d) => {
            const [x, y] = toOutline(d.lon, d.lat);
            return <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="13" vector-effect="non-scaling-stroke" />;
          })
        }
      </svg>
      <div class="menu__contact">
        <p class="menu__heading">Get in touch</p>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
        <span>{site.address}</span>
      </div>
      <ul class="menu__social">
        {
          site.social.map((s) => (
            <li>
              <a href={s.href}>{s.label}</a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary" href="#contact" data-menu-link>
        Plan your trip
        <Icon name="arrow" size={18} />
      </a>
    </aside>
  </div>

  <div class="meander menu__meander" aria-hidden="true"></div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 14px var(--gutter) 0;
    pointer-events: none;
    transition: transform 0.5s var(--ease-out);
  }

  .site-header > * {
    pointer-events: auto;
  }

  .site-header.is-hidden {
    transform: translateY(-130%);
  }

  .site-header__logo,
  .menu__logo {
    flex: none;
    padding: 7px;
    margin: -7px;
    border-radius: 50%;
  }

  .site-header__logo img,
  .menu__logo img {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    box-shadow: 0 10px 30px -12px rgb(0 27 46 / 0.55);
    transition: transform 0.5s var(--ease-out);
  }

  .site-header__logo:hover img {
    transform: rotate(-6deg) scale(1.03);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
  }

  .site-header__cta {
    min-height: 52px;
  }

  .menu-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 22px 0 18px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--blue-900);
    font-size: 0.95rem;
    font-weight: 650;
    box-shadow: 0 12px 30px -14px rgb(0 27 46 / 0.6);
    transition:
      background-color 0.25s,
      color 0.25s,
      transform 0.35s var(--ease-out);
  }

  .menu-button:hover {
    background: var(--sun-300);
    color: var(--blue-900);
    transform: translateY(-2px);
  }

  .site-header.is-light .menu-button {
    background: var(--blue-700);
    color: var(--white);
  }

  .site-header.is-light .menu-button:hover {
    background: var(--blue-600);
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow-y: auto;
    background:
      radial-gradient(70% 60% at 85% 15%, rgb(44 125 176 / 0.55) 0%, transparent 60%),
      radial-gradient(60% 60% at 0% 100%, rgb(242 193 78 / 0.14) 0%, transparent 60%),
      linear-gradient(160deg, var(--blue-700) 0%, var(--blue-900) 100%);
    color: var(--white);
    clip-path: circle(0 at calc(100% - 70px) 44px);
    visibility: hidden;
    transition:
      clip-path 0.6s var(--ease-in-out),
      visibility 0s 0.6s;
  }

  .menu.is-open {
    clip-path: circle(150% at calc(100% - 70px) 44px);
    visibility: visible;
    transition:
      clip-path 0.75s var(--ease-in-out),
      visibility 0s;
  }

  .menu__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 14px var(--gutter) 0;
  }

  .menu-button--close {
    margin-top: 16px;
  }

  .menu__body {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    align-items: center;
    gap: clamp(40px, 6vw, 110px);
    padding-block: 40px;
  }

  .menu__links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__links li {
    border-bottom: 1px solid rgb(255 255 255 / 0.14);
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }

  .menu.is-open .menu__links li {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease-out) calc(0.25s + var(--i) * 0.06s),
      transform 0.7s var(--ease-out) calc(0.25s + var(--i) * 0.06s);
  }

  .menu__links a {
    display: flex;
    align-items: baseline;
    gap: clamp(16px, 2.4vw, 32px);
    padding: clamp(10px, 1.4vw, 18px) 0;
    color: var(--white);
    text-decoration: none;
  }

  .menu__num {
    flex: none;
    width: 2.4em;
    color: var(--sun-500);
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 0.8rem + 0.4vw, 1.15rem);
  }

  .menu__label {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.3rem + 3.4vw, 4.4rem);
    line-height: 1.05;
    transition:
      transform 0.45s var(--ease-out),
      color 0.3s;
  }

  .menu__links :global(.menu__arrow) {
    align-self: center;
    margin-left: auto;
    color: var(--sun-500);
    opacity: 0;
    transform: translateX(-12px);
    transition:
      opacity 0.3s,
      transform 0.45s var(--ease-out);
  }

  .menu__links a:hover .menu__label,
  .menu__links a:focus-visible .menu__label {
    color: var(--sun-300);
    transform: translateX(10px);
  }

  .menu__links a:hover :global(.menu__arrow),
  .menu__links a:focus-visible :global(.menu__arrow) {
    opacity: 1;
    transform: none;
  }

  .menu__aside {
    display: grid;
    justify-items: start;
    gap: 26px;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .menu.is-open .menu__aside {
    opacity: 1;
    transition: opacity 0.8s var(--ease-out) 0.5s;
  }

  .menu__map {
    width: min(100%, 320px);
    height: auto;
  }

  .menu__land {
    fill: rgb(255 255 255 / 0.1);
    stroke: rgb(255 255 255 / 0.35);
    stroke-width: 0.8;
  }

  .menu__route {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .menu__route--road {
    stroke: var(--sun-500);
  }

  .menu__route--sea {
    stroke: var(--sun-300);
    stroke-dasharray: 4 4;
  }

  .menu__map circle {
    fill: var(--sun-500);
    stroke: var(--white);
    stroke-width: 2;
  }

  .menu__contact {
    display: grid;
    gap: 6px;
    color: rgb(255 255 255 / 0.8);
  }

  .menu__heading {
    margin-bottom: 4px;
    color: var(--sun-300);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .menu__contact a,
  .menu__social a {
    color: var(--white);
    text-decoration: none;
  }

  .menu__contact a:hover,
  .menu__social a:hover {
    color: var(--sun-300);
  }

  .menu__social {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }

  .menu__meander {
    margin-bottom: 28px;
    opacity: 0.6;
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .menu__body {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 40px;
      padding-block: 24px 40px;
    }

    .menu__map {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .site-header {
      padding-top: 10px;
    }

    .site-header__logo img,
    .menu__logo img {
      width: 76px;
      height: 76px;
    }

    .site-header__cta {
      display: none;
    }

    .site-header__actions,
    .menu-button--close {
      margin-top: 12px;
    }

    .menu-button {
      padding: 0 18px 0 15px;
    }

    .menu__top {
      padding-top: 10px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (header && menu && openBtn && closeBtn) {
    const outside = [header, document.querySelector('main'), document.querySelector('footer')].filter(Boolean) as HTMLElement[];
    let returnFocus: HTMLElement | null = null;

    const setOpen = (open: boolean) => {
      menu.classList.toggle('is-open', open);
      menu.inert = !open;
      menu.setAttribute('aria-hidden', String(!open));
      openBtn.setAttribute('aria-expanded', String(open));
      document.documentElement.classList.toggle('menu-open', open);
      outside.forEach((el) => (el.inert = open));
      if (open) {
        returnFocus = document.activeElement as HTMLElement | null;
        closeBtn.focus();
      } else {
        (returnFocus ?? openBtn).focus({ preventScroll: true });
      }
    };

    openBtn.addEventListener('click', () => setOpen(true));
    closeBtn.addEventListener('click', () => setOpen(false));
    menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setOpen(false);
        return;
      }
      if (e.key !== 'Tab') return;
      const items = [...menu.querySelectorAll<HTMLElement>('a[href], button')];
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    if (hero) {
      new IntersectionObserver(([entry]) => header.classList.toggle('is-light', !entry.isIntersecting), {
        rootMargin: '-90px 0px 0px 0px',
      }).observe(hero);
    }

    let lastY = window.scrollY;
    window.addEventListener(
      'scroll',
      () => {
        const y = window.scrollY;
        header.classList.toggle('is-hidden', y > lastY && y > 240 && !menu.classList.contains('is-open'));
        lastY = y;
      },
      { passive: true },
    );
  }
</script>
