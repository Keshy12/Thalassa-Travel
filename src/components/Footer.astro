---
import { journeys } from '../data/journeys';
import { site } from '../data/site';
import { asset } from '../lib/asset';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src={asset('brand/logo-badge.svg')} alt="Thalassa Travel" width="120" height="120" loading="lazy" />
      <p>{site.description}</p>
    </div>
    <nav class="footer__col" aria-label="Journeys">
      <h2>Journeys</h2>
      <ul>
        {
          journeys.map((j) => (
            <li>
              <a href="#journeys">{j.name}</a>
            </li>
          ))
        }
        <li><a href="#contact">Tailor-made trips</a></li>
      </ul>
    </nav>
    <nav class="footer__col" aria-label="Explore">
      <h2>Explore</h2>
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="footer__col">
      <h2>Contact</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>
        <li>{site.address}</li>
      </ul>
      <ul class="footer__social">
        {
          site.social.map((s) => (
            <li>
              <a href={s.href}>{s.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="container footer__bottom">
    <p>© {year} {site.name}. All rights reserved.</p>
    <p class="footer__credits">
      Map data: <a href="https://www.naturalearthdata.com/" rel="noopener">Natural Earth</a>. Elevation:{' '}
      <a href="https://registry.opendata.aws/terrain-tiles/" rel="noopener">Terrain Tiles</a> (Mapzen, AWS Open Data), including
      SRTM, GMTED2010, ETOPO1 and Copernicus EU-DEM data.
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(64px, 8vw, 104px) 32px;
    background: var(--blue-950);
    color: rgb(255 255 255 / 0.72);
    font-size: 0.92rem;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 64px);
  }

  .footer__brand {
    display: grid;
    align-content: start;
    gap: 22px;
    max-width: 340px;
  }

  .footer__brand img {
    width: 120px;
    height: 120px;
  }

  .footer h2 {
    margin-bottom: 18px;
    color: var(--white);
    font-size: 1.2rem;
  }

  .footer ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer a:hover {
    color: var(--sun-500);
  }

  .footer__social {
    display: flex !important;
    flex-wrap: wrap;
    gap: 8px 16px !important;
    margin-top: 22px !important;
  }

  .footer__social a {
    color: var(--white);
    font-weight: 600;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.8rem;
  }

  .footer__credits {
    max-width: 640px;
    color: rgb(255 255 255 / 0.5);
  }

  .footer__credits a {
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.3);
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
