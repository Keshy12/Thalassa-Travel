---
import { destinations } from '../data/destinations';
import outline from '../data/greece-outline.json';

const WORLD = 256 * 2 ** 8;
const toOutline = (lon: number, lat: number) => {
  const s = Math.sin((lat * Math.PI) / 180);
  const x = ((lon + 180) / 360) * WORLD;
  const y = (0.5 - Math.log((1 + s) / (1 - s)) / (4 * Math.PI)) * WORLD;
  return [(x - outline.projection.originX) * outline.projection.scale, (y - outline.projection.originY) * outline.projection.scale];
};
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="hero" id="top" data-hero>
  <div class="hero__stage" data-stage>
    <svg class="hero__fallback" viewBox={outline.viewBox} aria-hidden="true">
      <path d={outline.d}></path>
      {
        destinations.map((d) => {
          const [x, y] = toOutline(d.lon, d.lat);
          return <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="7" />;
        })
      }
    </svg>
    <canvas class="hero__canvas" data-canvas aria-hidden="true"></canvas>
    <div class="hero__scrim" aria-hidden="true"></div>

    <svg class="hero__links" data-links aria-hidden="true">
      <path></path>
      <path></path>
      <path></path>
    </svg>

    <div class="hero__pins">
      {
        destinations.map((d, i) => (
          <button class="pin" type="button" data-pin={i} data-goto={i} tabindex="-1" aria-hidden="true">
            <span class="pin__dot" />
            <span class="pin__label">{d.name}</span>
          </button>
        ))
      }
    </div>

    <div class="hero__cards" aria-hidden="true">
      {
        destinations.map((d, i) => (
          <div class="stop-cards" data-stop-cards={i}>
            {d.photos.map((p, j) => (
              <figure class="map-card" data-card style={`--i:${j}`}>
                <div class="map-card__inner">
                  <img src={p.src} alt="" width="1200" height="900" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                  <figcaption>
                    <span class="map-card__num">{pad(j + 1)}</span>
                    {p.caption}
                  </figcaption>
                </div>
              </figure>
            ))}
          </div>
        ))
      }
    </div>

    <div class="container hero__inner">
      <div class="hero__content" data-content>
        <p class="eyebrow hero__eyebrow">Guided journeys across Greece</p>
        <h1>Follow the sea into the stories of Greece</h1>
        <p class="hero__lead">
          Small-group trips from Athens to the islands, led by local experts, with an AR device that shows ancient sites as
          they once stood.
        </p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href="#journeys">
            Explore journeys
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
              ><path d="M5 12h14M13 6l6 6-6 6"></path></svg
            >
          </a>
          <a class="btn btn--ghost" href="#destinations">See destinations</a>
        </div>
      </div>
    </div>

    <div class="hero__tourbar" data-tourbar>
      <div class="container tourbar">
        <p class="tourbar__title">On the map</p>
        <ol class="tourbar__list">
          {
            destinations.map((d, i) => (
              <li class="tourbar__item" data-tour-item={i}>
                <button type="button" data-goto={i} aria-label={`Show ${d.name} on the map`}>
                  <span class="tourbar__num">{pad(i + 1)}</span>
                  <span class="tourbar__name">{d.name}</span>
                  <span class="tourbar__bar" aria-hidden="true">
                    <i />
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
        <button class="tourbar__pause" type="button" data-pause aria-pressed="false">
          <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5h3v14H8zM13 5h3v14h-3z"></path></svg>
          <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5l11 7-11 7z"></path></svg>
          <span class="visually-hidden" data-pause-label>Pause map tour</span>
        </button>
      </div>
    </div>
  </div>
  <p class="visually-hidden" aria-live="polite" data-live></p>
</section>

<script>
  import '../scripts/hero';
</script>

<style>
  .hero {
    position: relative;
    background: #03304f;
    color: var(--white);
  }

  .hero__stage {
    position: relative;
    height: 100svh;
    min-height: 680px;
    max-height: 1100px;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(120% 90% at 70% 55%, #0a4a73 0%, #03304f 55%, #022640 100%);
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }

  .hero__stage.is-ready .hero__canvas {
    opacity: 1;
  }

  .hero__fallback {
    position: absolute;
    right: 4%;
    top: 14%;
    width: min(58%, 820px);
    height: auto;
    fill: rgb(242 193 78 / 0.16);
    stroke: rgb(242 193 78 / 0.55);
    stroke-width: 1.2;
    transition: opacity 1s var(--ease-out);
  }

  .hero__fallback circle {
    fill: var(--sun-500);
    stroke: var(--white);
    stroke-width: 3;
  }

  .hero__stage.is-ready .hero__fallback {
    opacity: 0;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(2 34 56 / 0.9) 0%, rgb(2 34 56 / 0.72) 30%, rgb(2 34 56 / 0.3) 46%, rgb(2 34 56 / 0) 60%),
      linear-gradient(180deg, rgb(2 34 56 / 0.55) 0%, rgb(2 34 56 / 0) 22%),
      linear-gradient(0deg, rgb(2 34 56 / 0.7) 0%, rgb(2 34 56 / 0) 24%);
  }

  .hero__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s;
  }

  .hero__links.is-visible {
    opacity: 1;
    transition-delay: 0.25s;
  }

  .hero__links path {
    fill: none;
    stroke: rgb(255 255 255 / 0.85);
    stroke-width: 1.4;
    stroke-dasharray: 2 5;
    stroke-linecap: round;
  }

  .hero__pins,
  .hero__cards {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pin {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--white);
    pointer-events: auto;
    transition: opacity 0.4s;
    will-change: transform;
  }

  .pin.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .pin__dot {
    position: relative;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border: 2.5px solid var(--white);
    border-radius: 50%;
    background: var(--sun-500);
    box-shadow: 0 2px 10px rgb(0 27 46 / 0.5);
    transition: transform 0.4s var(--ease-out);
  }

  .pin__dot::after {
    content: '';
    position: absolute;
    inset: -9px;
    border: 1.5px solid rgb(242 193 78 / 0.9);
    border-radius: 50%;
    opacity: 0;
  }

  .pin__label {
    margin-top: -7px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: rgb(0 42 67 / 0.62);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition:
      background-color 0.3s,
      color 0.3s,
      transform 0.4s var(--ease-out);
  }

  .pin:hover .pin__label {
    background: var(--white);
    color: var(--blue-800);
  }

  .pin.is-active .pin__dot {
    transform: scale(1.25);
  }

  .pin.is-active .pin__dot::after {
    animation: pin-pulse 2s var(--ease-out) infinite;
  }

  .pin.is-active .pin__label {
    background: var(--sun-500);
    color: var(--blue-900);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  @keyframes pin-pulse {
    from {
      opacity: 1;
      transform: scale(0.6);
    }
    to {
      opacity: 0;
      transform: scale(1.8);
    }
  }

  .stop-cards {
    position: absolute;
    inset: 0;
    visibility: hidden;
    transition: visibility 0s 0.6s;
  }

  .stop-cards.is-visible {
    visibility: visible;
    transition: visibility 0s;
  }

  .map-card {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    will-change: transform;
  }

  .map-card__inner {
    padding: 8px 8px 0;
    border-radius: 16px;
    background: var(--paper);
    box-shadow:
      0 2px 6px rgb(0 27 46 / 0.18),
      0 30px 60px -24px rgb(0 27 46 / 0.7);
    color: var(--blue-900);
    opacity: 0;
    transform: translateY(18px) scale(0.94);
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
  }

  .stop-cards.is-visible .map-card__inner {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s var(--ease-out) calc(var(--i) * 140ms + 120ms),
      transform 0.9s var(--ease-out) calc(var(--i) * 140ms + 120ms);
  }

  .map-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 10px;
    background: var(--blue-100);
  }

  .map-card figcaption {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 11px 4px 13px;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .map-card__num {
    color: var(--sun-600);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 400;
  }

  .hero__inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .hero__content {
    width: min(100%, 560px);
    padding-top: 40px;
    pointer-events: auto;
  }

  .hero__eyebrow {
    color: var(--sun-300);
  }

  .hero h1 {
    margin: 22px 0 22px;
    color: var(--white);
    font-size: clamp(2.6rem, 1.5rem + 3.4vw, 4.5rem);
    line-height: 1.04;
    text-shadow: 0 2px 30px rgb(0 27 46 / 0.35);
  }

  .hero__lead {
    max-width: 30em;
    color: rgb(255 255 255 / 0.84);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .hero__tourbar {
    position: absolute;
    inset: auto 0 0;
    padding-bottom: 22px;
  }

  .tourbar {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .tourbar__title {
    flex: none;
    color: var(--sun-300);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .tourbar__list {
    display: grid;
    flex: 1;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tourbar__item button {
    display: grid;
    width: 100%;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 2px 10px;
    padding: 10px 4px 0;
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.62);
    text-align: left;
    transition: color 0.3s;
  }

  .tourbar__item button:hover,
  .tourbar__item.is-active button {
    color: var(--white);
  }

  .tourbar__num {
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--sun-500);
  }

  .tourbar__name {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .tourbar__bar {
    grid-column: 1 / -1;
    height: 2px;
    margin-top: 10px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.2);
    overflow: hidden;
  }

  .tourbar__bar i {
    display: block;
    height: 100%;
    background: var(--sun-500);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }

  .tourbar__item.is-active .tourbar__bar {
    background: rgb(255 255 255 / 0.35);
  }

  .tourbar__pause {
    display: grid;
    flex: none;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 50%;
    background: rgb(0 42 67 / 0.4);
    color: var(--white);
    transition:
      background-color 0.25s,
      border-color 0.25s;
  }

  .tourbar__pause[hidden] {
    display: none;
  }

  .tourbar__pause:hover {
    border-color: var(--white);
    background: rgb(255 255 255 / 0.12);
  }

  .tourbar__pause svg {
    grid-area: 1 / 1;
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .tourbar__pause .icon-play,
  .tourbar__pause[aria-pressed='true'] .icon-pause {
    display: none;
  }

  .tourbar__pause[aria-pressed='true'] .icon-play {
    display: block;
  }

  .hero__stage.is-static .tourbar__pause,
  .hero__stage.is-static .tourbar__bar {
    display: none;
  }

  @media (max-width: 1100px) {
    .tourbar__title {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hero__stage {
      min-height: 760px;
    }

    .hero__scrim {
      background:
        linear-gradient(180deg, rgb(2 34 56 / 0.85) 0%, rgb(2 34 56 / 0.55) 42%, rgb(2 34 56 / 0) 62%),
        linear-gradient(0deg, rgb(2 34 56 / 0.75) 0%, rgb(2 34 56 / 0) 26%);
    }

    .hero__inner {
      align-items: flex-start;
      padding-top: 118px;
    }

    .hero__content {
      padding-top: 0;
    }

    .hero h1 {
      margin: 14px 0;
      font-size: clamp(2.2rem, 1.4rem + 4vw, 3.4rem);
    }

    .hero__lead {
      font-size: 1rem;
    }

    .hero__ctas {
      margin-top: 22px;
    }

    .hero__fallback {
      top: auto;
      bottom: 16%;
      right: 10%;
      width: 80%;
    }

    .hero__tourbar {
      padding-bottom: 14px;
    }

    .tourbar {
      gap: 10px;
    }

    .tourbar__list {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
      gap: 6px;
      mask-image: linear-gradient(90deg, #000 85%, transparent);
    }

    .tourbar__list::-webkit-scrollbar {
      display: none;
    }

    .tourbar__item {
      flex: none;
    }

    .tourbar__item button {
      padding: 8px 12px;
      border: 1px solid rgb(255 255 255 / 0.22);
      border-radius: var(--radius-pill);
      background: rgb(0 42 67 / 0.5);
    }

    .tourbar__item.is-active button {
      border-color: var(--sun-500);
      background: var(--sun-500);
      color: var(--blue-900);
    }

    .tourbar__item.is-active .tourbar__num {
      color: var(--blue-800);
    }

    .tourbar__bar {
      display: none;
    }

    .map-card figcaption {
      padding: 8px 2px 9px;
      font-size: 0.7rem;
    }

    .map-card__num {
      display: none;
    }

    .map-card__inner {
      padding: 5px 5px 0;
      border-radius: 12px;
    }

    .map-card img {
      border-radius: 8px;
    }
  }

  @media (max-width: 520px) {
    .hero__lead {
      display: none;
    }

    .pin__label {
      font-size: 0.7rem;
    }
  }
</style>
