---
import { destinations } from '../data/destinations';
import { journeys } from '../data/journeys';
import { outline, toOutline } from '../lib/outline';
import route from '../data/route.json';
import { buildTimeline } from '../scripts/map/journey';
import Icon from './Icon.astro';
import Laurels from './Laurels.astro';

const pad = (n: number) => String(n).padStart(2, '0');
const timeline = buildTimeline(route.legs.map((l) => l.km));
const odyssey = journeys.find((j) => j.id === 'odyssey')!;
const km = new Intl.NumberFormat('en-GB');
const nextLine = (i: number) => {
  const leg = route.legs[i];
  if (!leg) return 'Final stop of the journey';
  const modes = [...new Set(leg.segments.map((s) => (s.mode === 'sea' ? 'ferry' : 'road')))];
  return `Next: ${destinations[i + 1].name} · ${km.format(leg.km)} km by ${modes.join(' and ')}`;
};
---

<section class="journey" id="top" data-hero style={`--units:${timeline.total.toFixed(3)}`}>
  <div class="journey__stage" data-stage>
    <svg class="journey__fallback" viewBox={outline.viewBox} aria-hidden="true">
      <path d={outline.d}></path>
      {
        destinations.map((d) => {
          const [x, y] = toOutline(d.lon, d.lat);
          return <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="7" />;
        })
      }
    </svg>
    <canvas class="journey__canvas" data-canvas aria-hidden="true"></canvas>
    <div class="journey__scrim" aria-hidden="true"></div>

    <svg class="journey__links" data-links aria-hidden="true">
      <path></path>
      <path></path>
      <path></path>
    </svg>

    <div class="journey__layer">
      {
        destinations.map((d, i) => (
          <button class="pin" type="button" data-pin={i} data-goto={i} tabindex="-1" aria-hidden="true">
            <span class="pin__dot" />
            <span class="pin__label">{d.name}</span>
          </button>
        ))
      }
    </div>

    <div class="traveler" data-traveler data-mode="road" aria-hidden="true">
      <span class="traveler__icon">
        <Icon name="car" size={22} class="traveler__car" />
        <Icon name="ship" size={22} class="traveler__ship" />
      </span>
      <span class="traveler__label">
        <strong data-traveler-title></strong>
        <span data-traveler-meta></span>
      </span>
    </div>

    <div class="journey__layer" aria-hidden="true">
      {
        destinations.map((d, i) => (
          <div class="polaroids" data-polaroids={i}>
            {d.photos.map((p, j) => (
              <figure class="polaroid" data-polaroid style={`--i:${j}`}>
                <div class="polaroid__inner">
                  <img src={p.src} alt="" width="1200" height="900" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
                  <figcaption>{p.caption}</figcaption>
                </div>
              </figure>
            ))}
          </div>
        ))
      }
    </div>

    <div class="container journey__inner">
      <div class="journey__panels" data-content>
        <div class="panel panel--intro is-active" data-panel="intro">
          <p class="eyebrow panel__eyebrow">Guided journeys across Greece</p>
          <h1>Follow the sea into the stories of Greece</h1>
          <p class="panel__lead">
            Small-group trips from Athens across the Peloponnese to Zakynthos, led by local experts, with an AR device that shows
            ancient sites as they once stood.
          </p>
          <div class="panel__ctas">
            <a class="btn btn--primary" href="#journeys">
              Explore journeys
              <Icon name="arrow" size={18} />
            </a>
            <a class="btn btn--ghost" href="#destinations">See destinations</a>
          </div>
        </div>

        {
          destinations.map((d, i) => (
            <article class="panel panel--stop" data-panel={`stop-${i}`} inert>
              <p class="eyebrow panel__eyebrow">
                Stop {pad(i + 1)} · {d.region}
              </p>
              <h2>{d.name}</h2>
              <p class="panel__tagline">{d.tagline}</p>
              <ul class="panel__tags">
                {d.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
              <p class="panel__next">{nextLine(i)}</p>
            </article>
          ))
        }

        <div class="panel panel--outro" data-panel="outro" inert>
          <Laurels class="panel__crest">
            <span class="panel__crest-num">{destinations.length}</span>
            <span class="panel__crest-label">destinations</span>
          </Laurels>
          <p class="eyebrow panel__eyebrow">{odyssey.name}</p>
          <h2>One route, a whole story of Greece</h2>
          <ul class="panel__stats">
            <li><strong>{odyssey.days}</strong> days</li>
            <li><strong>{km.format(route.totals.road)}</strong> km by road</li>
            <li><strong>{km.format(route.totals.sea)}</strong> km by ferry</li>
          </ul>
          <div class="panel__ctas">
            <a class="btn btn--primary" href="#contact" data-journey={odyssey.id}>
              Plan this journey
              <Icon name="arrow" size={18} />
            </a>
            <a class="btn btn--ghost" href="#journeys">All journeys</a>
          </div>
        </div>
      </div>
    </div>

    <div class="journey__cue" aria-hidden="true">
      <span>Scroll to begin the journey</span>
      <i></i>
    </div>

    <div class="journey__bar" data-tourbar>
      <div class="container tourbar">
        <p class="tourbar__title">The route</p>
        <ol class="tourbar__list">
          {
            destinations.map((d, i) => (
              <li class="tourbar__item" data-tour-item={i}>
                <button type="button" data-goto={i} aria-label={`Go to ${d.name}`}>
                  <span class="tourbar__num">{pad(i + 1)}</span>
                  <span class="tourbar__name">{d.name}</span>
                  <span class="tourbar__bar" aria-hidden="true">
                    <i />
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
        <button class="tourbar__skip" type="button" data-skip>
          Skip
          <Icon name="arrowDown" size={16} />
        </button>
      </div>
    </div>
  </div>
  <p class="visually-hidden" aria-live="polite" data-live></p>
</section>

<script>
  import '../scripts/hero';
</script>

<style>
  .journey {
    --unit: 30svh;
    position: relative;
    height: calc(100svh + var(--units, 21.6) * var(--unit));
    background: #03304f;
    color: var(--white);
  }

  .journey.is-static {
    height: auto;
  }

  .journey__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: radial-gradient(120% 90% at 70% 55%, #0a4a73 0%, #03304f 55%, #022640 100%);
  }

  .journey.is-static .journey__stage {
    position: relative;
    min-height: 680px;
  }

  .journey__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }

  .journey__stage.is-ready .journey__canvas {
    opacity: 1;
  }

  .journey__fallback {
    position: absolute;
    right: 4%;
    top: 14%;
    width: min(58%, 820px);
    height: auto;
    fill: rgb(242 193 78 / 0.16);
    stroke: rgb(242 193 78 / 0.55);
    stroke-width: 1.2;
    transition: opacity 1s var(--ease-out);
  }

  .journey__fallback circle {
    fill: var(--sun-500);
    stroke: var(--white);
    stroke-width: 3;
  }

  .journey__stage.is-ready .journey__fallback {
    opacity: 0;
  }

  .journey__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(2 34 56 / 0.9) 0%, rgb(2 34 56 / 0.72) 30%, rgb(2 34 56 / 0.3) 46%, rgb(2 34 56 / 0) 60%),
      linear-gradient(180deg, rgb(2 34 56 / 0.5) 0%, rgb(2 34 56 / 0) 20%),
      linear-gradient(0deg, rgb(2 34 56 / 0.7) 0%, rgb(2 34 56 / 0) 24%);
  }

  .journey__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .journey__links.is-visible {
    opacity: 1;
    transition-delay: 0.35s;
  }

  .journey__links path {
    fill: none;
    stroke: rgb(255 255 255 / 0.85);
    stroke-width: 1.4;
    stroke-dasharray: 2 5;
    stroke-linecap: round;
  }

  .journey__layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .pin {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--white);
    pointer-events: auto;
    transition: opacity 0.4s;
    will-change: transform;
  }

  .pin.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .pin__dot {
    position: absolute;
    left: -7px;
    top: -7px;
    width: 14px;
    height: 14px;
    border: 2.5px solid var(--white);
    border-radius: 50%;
    background: var(--sun-500);
    box-shadow: 0 2px 10px rgb(0 27 46 / 0.5);
    transition: transform 0.4s var(--ease-out);
  }

  .pin__dot::after {
    content: '';
    position: absolute;
    inset: -9px;
    border: 1.5px solid rgb(242 193 78 / 0.9);
    border-radius: 50%;
    opacity: 0;
  }

  .pin__label {
    position: absolute;
    top: 0;
    left: 14px;
    padding: 4px 10px;
    transform: translateY(-50%);
    border-radius: var(--radius-pill);
    background: var(--blue-900);
    box-shadow: 0 4px 14px -6px rgb(0 0 0 / 0.5);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition:
      opacity 0.25s,
      background-color 0.3s,
      color 0.3s;
  }

  .pin.is-left .pin__label {
    left: auto;
    right: 14px;
  }

  .pin.is-quiet .pin__label {
    opacity: 0;
  }

  .pin.is-quiet:hover .pin__label {
    opacity: 1;
  }

  .pin:hover .pin__label,
  .pin.is-next .pin__label {
    background: var(--white);
    color: var(--blue-800);
  }

  .pin.is-active .pin__dot {
    transform: scale(1.25);
  }

  .pin.is-active .pin__dot::after {
    animation: pulse 2s var(--ease-out) infinite;
  }

  .pin.is-active .pin__label {
    background: var(--sun-500);
    color: var(--blue-900);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  @keyframes pulse {
    from {
      opacity: 1;
      transform: scale(0.6);
    }
    to {
      opacity: 0;
      transform: scale(1.8);
    }
  }

  .traveler {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s;
    will-change: transform;
  }

  .traveler.is-visible {
    opacity: 1;
  }

  .traveler.is-flipped {
    flex-direction: row-reverse;
    translate: -100% 0;
  }

  .traveler__icon {
    position: relative;
    display: grid;
    flex: none;
    width: 42px;
    height: 42px;
    margin: -21px 0 0 -21px;
    place-items: center;
    border: 2.5px solid var(--white);
    border-radius: 50%;
    background: var(--sun-500);
    color: var(--blue-900);
    box-shadow: 0 6px 18px rgb(0 27 46 / 0.5);
  }

  .traveler__icon::before {
    content: '';
    position: absolute;
    inset: -3px;
    border: 2px solid rgb(242 193 78 / 0.8);
    border-radius: 50%;
    animation: pulse 1.8s var(--ease-out) infinite;
  }

  .traveler.is-flipped .traveler__icon {
    margin: -21px -21px 0 0;
  }

  .traveler__icon :global(svg) {
    grid-area: 1 / 1;
  }

  .traveler[data-mode='road'] :global(.traveler__ship),
  .traveler[data-mode='sea'] :global(.traveler__car) {
    display: none;
  }

  .traveler__label {
    display: grid;
    margin-top: -21px;
    padding: 7px 13px 8px;
    border-radius: 12px;
    background: var(--paper);
    color: var(--blue-900);
    box-shadow: 0 10px 26px -12px rgb(0 27 46 / 0.7);
    line-height: 1.25;
    white-space: nowrap;
  }

  .traveler__label strong {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 400;
  }

  .traveler__label span {
    color: var(--ink-mute);
    font-size: 0.72rem;
    font-weight: 600;
  }

  .polaroids {
    position: absolute;
    inset: 0;
    visibility: hidden;
    transition: visibility 0s 0.5s;
  }

  .polaroids.is-visible {
    visibility: visible;
    transition: visibility 0s;
  }

  .polaroid {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    will-change: transform;
  }

  .polaroid__inner {
    position: relative;
    padding: 4.5% 4.5% 0;
    border-radius: 3px;
    background: #fffdf8;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.25),
      0 26px 50px -20px rgb(0 20 35 / 0.75);
    opacity: 0;
    transform: translateY(46px) scale(0.35) rotate(-16deg);
    transition:
      opacity 0.25s ease,
      transform 0.35s ease;
  }

  .polaroid__inner::before {
    content: '';
    position: absolute;
    top: -11px;
    left: 50%;
    width: 38%;
    height: 22px;
    background: rgb(247 216 138 / 0.82);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
    transform: translateX(-50%) rotate(-3deg);
  }

  .polaroids.is-visible .polaroid__inner {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.3s ease calc(var(--i) * 160ms + 60ms),
      transform 0.75s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--i) * 160ms + 60ms);
  }

  .polaroid img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--blue-100);
  }

  .polaroid figcaption {
    padding: 0.8em 0.4em 1.05em;
    color: var(--blue-900);
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.2;
    text-align: center;
  }

  .journey__inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding-block: 110px 120px;
    pointer-events: none;
  }

  .journey__panels {
    display: grid;
    width: min(100%, 560px);
  }

  .panel {
    grid-area: 1 / 1;
    align-self: center;
    opacity: 0;
    transform: translateY(18px);
    visibility: hidden;
    pointer-events: auto;
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.55s var(--ease-out),
      visibility 0s 0.55s;
  }

  .panel.is-active {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition:
      opacity 0.7s var(--ease-out) 0.15s,
      transform 0.8s var(--ease-out) 0.15s,
      visibility 0s;
  }

  .panel__eyebrow {
    color: var(--sun-300);
  }

  .panel h1 {
    margin: 22px 0;
    color: var(--white);
    font-size: clamp(2.6rem, 1.5rem + 3.4vw, 4.5rem);
    line-height: 1.04;
    text-shadow: 0 2px 30px rgb(0 27 46 / 0.35);
  }

  .panel h2 {
    margin: 16px 0 14px;
    color: var(--white);
    font-size: clamp(2.6rem, 1.6rem + 3.6vw, 4.8rem);
    line-height: 1;
  }

  .panel--outro h2 {
    font-size: clamp(2.2rem, 1.4rem + 2.6vw, 3.6rem);
    line-height: 1.06;
  }

  .panel__lead {
    max-width: 30em;
    color: rgb(255 255 255 / 0.84);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .panel__tagline {
    max-width: 22em;
    color: rgb(255 255 255 / 0.88);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
  }

  .panel__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .panel__tags li {
    padding: 6px 13px;
    border: 1px solid rgb(255 255 255 / 0.28);
    border-radius: var(--radius-pill);
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .panel__next {
    margin-top: 26px;
    color: var(--sun-300);
    font-size: 0.85rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  .panel :global(.panel__crest) {
    display: flex;
    width: fit-content;
    --laurel-size: 92px;
    --laurel-gap: 10px;
    --laurel-color: var(--sun-500);
    margin-bottom: 18px;
  }

  .panel__crest-num,
  .panel__crest-label {
    display: block;
    text-align: center;
  }

  .panel__crest-num {
    color: var(--white);
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
  }

  .panel__crest-label {
    margin-top: 4px;
    color: var(--sun-300);
    font-size: 0.66rem;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .panel__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 34px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    color: rgb(255 255 255 / 0.75);
    font-size: 0.9rem;
  }

  .panel__stats strong {
    display: block;
    color: var(--white);
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .panel__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .journey__cue {
    position: absolute;
    left: 50%;
    bottom: 112px;
    display: grid;
    justify-items: center;
    gap: 12px;
    color: rgb(255 255 255 / 0.82);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: var(--intro, 1);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .journey__cue i {
    width: 2px;
    height: 40px;
    background: linear-gradient(var(--sun-500), transparent);
    transform-origin: top;
    animation: cue 1.8s var(--ease-in-out) infinite;
  }

  @keyframes cue {
    0% {
      opacity: 1;
      transform: scaleY(0);
    }
    70% {
      opacity: 1;
      transform: scaleY(1);
    }
    100% {
      opacity: 0;
      transform: scaleY(1);
    }
  }

  .journey__bar {
    position: absolute;
    inset: auto 0 0;
    padding-bottom: 22px;
  }

  .tourbar {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .tourbar__title {
    flex: none;
    color: var(--sun-300);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .tourbar__list {
    display: grid;
    flex: 1;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tourbar__item button {
    display: grid;
    width: 100%;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 2px 10px;
    padding: 10px 4px 0;
    border: 0;
    background: none;
    color: rgb(255 255 255 / 0.62);
    text-align: left;
    transition: color 0.3s;
  }

  .tourbar__item button:hover,
  .tourbar__item.is-active button {
    color: var(--white);
  }

  .tourbar__num {
    color: var(--sun-500);
    font-family: var(--font-display);
    font-size: 0.85rem;
  }

  .tourbar__name {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .tourbar__bar {
    grid-column: 1 / -1;
    height: 2px;
    margin-top: 10px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.2);
    overflow: hidden;
  }

  .tourbar__bar i {
    display: block;
    height: 100%;
    background: var(--sun-500);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }

  .tourbar__skip {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid rgb(255 255 255 / 0.32);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--white);
    font-size: 0.85rem;
    font-weight: 600;
    transition:
      background-color 0.25s,
      border-color 0.25s,
      color 0.25s;
  }

  .tourbar__skip:hover {
    border-color: var(--white);
    background: var(--white);
    color: var(--blue-900);
  }

  .journey.is-static .tourbar__bar,
  .journey.is-static .tourbar__skip,
  .journey.is-static .journey__cue {
    display: none;
  }

  @media (max-width: 1100px) {
    .tourbar__title {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .journey__scrim {
      background:
        linear-gradient(180deg, rgb(2 34 56 / 0.88) 0%, rgb(2 34 56 / 0.6) 40%, rgb(2 34 56 / 0) 60%),
        linear-gradient(0deg, rgb(2 34 56 / 0.75) 0%, rgb(2 34 56 / 0) 26%);
    }

    .journey__inner {
      align-items: flex-start;
      padding-block: 112px 0;
    }

    .panel {
      align-self: start;
    }

    .panel h1 {
      margin: 14px 0;
      font-size: clamp(2.1rem, 1.3rem + 4vw, 3.3rem);
    }

    .panel h2 {
      margin: 10px 0 8px;
      font-size: clamp(2.2rem, 1.4rem + 4vw, 3.2rem);
    }

