---
import { media } from '../data/media';
import Icon from './Icon.astro';

const features = [
  { icon: 'layers', title: 'Reconstructions on site', text: 'Temples, colours and statues appear exactly where they once stood, based on archaeological research.' },
  { icon: 'language', title: 'Your guide, your language', text: 'Narration follows your guide and is available in the language you are most comfortable with.' },
  { icon: 'sparkle', title: 'Nothing to set up', text: 'Your guide fits the device on day one. No app, no account, no downloads.' },
  { icon: 'users', title: 'Shared with your group', text: 'Everyone sees the same moment at the same time, so the story stays a shared one.' },
] as const;
---

<section class="section ar" id="ar">
  <div class="meander ar__meander" aria-hidden="true"></div>
  <div class="container ar__grid">
    <div class="ar__text">
      <header class="section-head" data-reveal>
        <span class="eyebrow ar__eyebrow">AR guide included on every trip</span>
        <h2>See ancient Greece as it once stood</h2>
        <p>
          Every journey includes a lightweight AR device. Look at a ruin and watch it rebuild: the columns complete, the
          painted colours return and the sculptures take their place, while your guide tells the story behind them.
        </p>
      </header>
    </div>

    <figure class="compare" data-compare data-reveal>
      <div class="compare__frame">
        <img src={media.arToday.src} alt={media.arToday.alt} width="1200" height="900" loading="lazy" decoding="async" />
        <img
          class="compare__after"
          src={media.arReconstructed.src}
          alt={media.arReconstructed.alt}
          width="1200"
          height="900"
          loading="lazy"
          decoding="async"
        />
        <span class="compare__tag compare__tag--before">Today</span>
        <span class="compare__tag compare__tag--after">With AR</span>
        <span class="compare__handle" aria-hidden="true">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l-5 6 5 6M15 6l5 6-5 6"></path></svg>
        </span>
        <input
          class="compare__range"
          type="range"
          min="0"
          max="100"
          value="50"
          aria-label="Drag to compare the Parthenon today with its AR reconstruction"
        />
      </div>
      <figcaption>The Parthenon, Athens. Drag to compare today's ruin with the reconstruction you see through the device.</figcaption>
    </figure>

    <ul class="ar__features">
      {
        features.map((f, i) => (
          <li data-reveal style={`--reveal-delay:${i * 90}`}>
            <span class="ar__icon">
              <Icon name={f.icon} size={22} />
            </span>
            <div>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('.compare__range');
    if (!range) return;
    const set = (v: number) => root.style.setProperty('--pos', `${v}%`);
    range.addEventListener('input', () => set(Number(range.value)));
    set(Number(range.value));

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return;
    let touched = false;
    range.addEventListener('pointerdown', () => (touched = true), { once: true });
    range.addEventListener('keydown', () => (touched = true), { once: true });
    new IntersectionObserver(
      ([entry], obs) => {
        if (!entry.isIntersecting) return;
        obs.disconnect();
        const start = performance.now();
        const step = (now: number) => {
          if (touched) return;
          const t = Math.min(1, (now - start) / 2600);
          const v = 50 + Math.sin(t * Math.PI * 2) * 28 * (1 - t);
          range.value = String(v);
          set(v);
          if (t < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      },
      { threshold: 0.6 },
    ).observe(root);
  });
</script>

<style>
  .ar {
    overflow: hidden;
    background:
      radial-gradient(80% 60% at 85% 20%, rgb(44 125 176 / 0.45) 0%, transparent 60%),
      linear-gradient(180deg, var(--blue-800) 0%, var(--blue-900) 100%);
    color: var(--white);
  }

  .ar__meander {
    position: absolute;
    inset: 28px 0 auto;
    opacity: 0.5;
  }

  .ar__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    grid-template-areas:
      'text compare'
      'features features';
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
    row-gap: clamp(48px, 6vw, 80px);
  }

  .ar__text {
    grid-area: text;
  }

  .compare {
    grid-area: compare;
  }

  .ar .section-head {
    margin-bottom: 0;
  }

  .ar h2 {
    color: var(--white);
  }

  .ar .section-head p {
    color: rgb(255 255 255 / 0.78);
  }

  .ar__eyebrow {
    color: var(--sun-300);
  }

  .ar__features {
    display: grid;
    grid-area: features;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px 32px;
    padding-top: 36px;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ar__features li {
    display: flex;
    gap: 14px;
  }

  .ar__icon {
    display: grid;
    flex: none;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 12px;
    background: rgb(242 193 78 / 0.14);
    color: var(--sun-500);
  }

  .ar__features h3 {
    margin-bottom: 4px;
    color: var(--white);
    font-size: 1.2rem;
  }

  .ar__features p {
    color: rgb(255 255 255 / 0.7);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .compare {
    --pos: 50%;
    margin: 0;
  }

  .compare__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-l);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.12),
      0 40px 80px -30px rgb(0 0 0 / 0.6);
    touch-action: pan-y;
  }

  .compare__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .compare__after {
    clip-path: inset(0 0 0 var(--pos));
  }

  .compare__tag {
    position: absolute;
    top: 18px;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .compare__tag--before {
    left: 18px;
    background: rgb(250 247 242 / 0.9);
    color: var(--blue-800);
  }

  .compare__tag--after {
    right: 18px;
    background: var(--sun-500);
    color: var(--blue-900);
  }

  .compare__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: var(--white);
    transform: translateX(-1px);
    pointer-events: none;
  }

  .compare__handle svg {
    position: absolute;
    max-width: none;
    top: 50%;
    left: 50%;
    width: 48px;
    height: 48px;
    padding: 12px;
    border-radius: 50%;
    background: var(--white);
    box-shadow: 0 8px 24px rgb(0 27 46 / 0.35);
    fill: none;
    stroke: var(--blue-700);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform: translate(-50%, -50%);
  }

  .compare__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .compare__range:focus-visible + .compare__handle,
  .compare__frame:has(.compare__range:focus-visible) {
    outline: 2px solid var(--sun-500);
    outline-offset: 4px;
  }

  .compare figcaption {
    margin-top: 16px;
    color: rgb(255 255 255 / 0.6);
    font-size: 0.85rem;
  }

  @media (max-width: 1100px) {
    .ar__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 960px) {
    .ar__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'text'
        'compare'
        'features';
    }
  }

  @media (max-width: 560px) {
    .ar__features {
      grid-template-columns: 1fr;
    }
  }
</style>
